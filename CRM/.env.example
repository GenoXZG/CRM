DB_HOST=localhost
DB_USER=crm
DB_PASSWORD=
DB_NAME=crm_prueba1
DB_PORT=3306
PORT=3030
# Opcional: proveedor de mosaicos del mapa y atribución exigida por su licencia.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'

# Solo se usan para crear el administrador cuando usuarios está vacía.
CRM_ADMIN_EMAIL=admin@crm.local
CRM_ADMIN_PASSWORD=
# local para HTTP directo, test para pruebas aisladas, public para HTTPS tras Apache.
CRM_DEPLOYMENT=local
# Una sola IP literal, observada como par TCP dentro del contenedor. Requerida en public.
TRUSTED_PROXY_IP=
# public siempre aplica Secure. En local y test, true fuerza Secure incluso sobre HTTP.
COOKIE_SECURE=false

# Correo mediante Nodemailer/SMTP Gmail: login 2FA, recuperación y pruebas.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_TEST_TO=

# Solo con CRM_DEPLOYMENT=test. Destino compartido de acceso y recuperación.
# Vacío: correo de cada usuario.
AUTH_2FA_TO=

# Docker: define contraseñas propias. No se incluyen valores predeterminados.
# En volúmenes existentes deben coincidir con las contraseñas actuales de MySQL.
DOCKER_DB_NAME=crm_demo
DOCKER_DB_USER=crm
DOCKER_DB_PASSWORD=
DOCKER_DB_ROOT_PASSWORD=

# Valida CSP con report-only y cambia a enforce antes de publicar.
CSP_MODE=report-only
