<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nuevo Ticket | CRM TSV</title>
    
    <link href="/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.lineicons.com/5.0/lineicons.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/assignments.css">
    <link rel="stylesheet" href="/leaflet/leaflet.css">
    <link rel="stylesheet" href="/css/location-map.css">
    <link rel="stylesheet" href="/css/ticket-form.css">
    <link rel="stylesheet" href="/css/theme-dark.css">
</head>
<body class="assignments-view">
    
    <div class="d-flex">
        
        <aside id="sidebar">
            <%- include('partials/session-navigation') %>
        </aside>
        <button type="button" class="assignment-menu-backdrop toggler-btn" aria-label="Cerrar menú" tabindex="-1"></button>
        <div class="main assignment-main d-flex flex-column min-vh-100 w-100">
            
            <nav class="navbar navbar-expand border-bottom px-3 bg-white">
                <button class="toggler-btn btn" type="button"><i class="bi bi-list fs-4" aria-hidden="true"></i><span class="ms-1">Menú</span></button>
                <span class="ms-3 fw-bold text-secondary">Gestión de Servicios</span>
            </nav>

            <main class="assignment-page ticket-create-page p-3 p-lg-4">
              <header class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <div><h1 class="mb-1">Nuevo ticket</h1><p class="text-muted mb-0">Selecciona el cliente, define el servicio y confirma su ubicación.</p></div>
                <a href="<%= ticketListState %>" class="btn btn-outline-secondary">Volver a tickets</a>
              </header>
              <%- include('partials/ticket-create-form', { embedded: false }) %>
            </main>
        </div>
    </div>

    <%- include('partials/ticket-selection-modals') %>

    <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/leaflet/leaflet.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


    <% if (typeof alert !== 'undefined' && alert) { %>
        <div id="ticket-notice" hidden data-title="<%= alertTitle %>" data-message="<%= alertMessage %>" data-icon="<%= alertIcon %>"></div>

    <% } %>

    <script type="module" src="/assets/pages/ticket-form.js"></script>
</body>
</html>