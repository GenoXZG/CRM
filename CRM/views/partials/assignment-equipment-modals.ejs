    <div class="modal fade" id="modalSeleccionEquipo" tabindex="-1" aria-labelledby="assignment-equipment-title" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-lg">
                <div class="modal-header border-0 pb-0">
                    <h5 id="assignment-equipment-title" class="modal-title fw-bold ms-2">Inventario Disponible</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body pt-3">
                    <div class="alert alert-light border-0 d-flex align-items-center text-muted small">
                        <i class="bi bi-info-circle-fill me-2 fs-5 text-info"></i>
                        Selecciona el dispositivo GPS para vincularlo a la unidad.
                    </div>

                    <label class="form-label small" for="assignment-equipment-search">Buscar por marca, modelo, IMEI o módem</label>
                    <input type="search" id="assignment-equipment-search" class="form-control mb-3" placeholder="Buscar equipo disponible…">
                    <div class="table-responsive rounded-3 border" style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-hover align-middle mb-0" id="tablaEquipos">
                            <thead class="bg-light sticky-top">
                                <tr>
                                    <th class="ps-3 py-3">Marca/Modelo</th>
                                    <th>IMEI</th>
                                    <th>ID Módem</th>
                                    <th class="text-end pe-3">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if(equiposEnEspera && equiposEnEspera.length > 0) { %>
                                    <% equiposEnEspera.forEach(equipo => { %>
                                        <tr>
                                            <td class="ps-3">
                                                <div class="d-flex flex-column">
                                                    <span class="fw-bold text-dark"><%= equipo.Equipo_stock.Modelo_equipo %></span>
                                                    <small class="text-muted"><%= equipo.Equipo_stock.Marca_equipo %></small>
                                                </div>
                                            </td>
                                            <td class="font-monospace text-primary"><%= equipo.IMEI %></td>
                                            <td class="font-monospace"><%= equipo.ID_modem %></td>
                                            <td class="text-end pe-3">
                                                <button class="btn btn-outline-primary rounded-pill btn_seleccion_equipo"
                                                    data-id_equipo="<%= equipo.ID_equipo %>"
                                                    data-marca="<%= equipo.Equipo_stock.Marca_equipo %>"
                                                    data-modelo="<%= equipo.Equipo_stock.Modelo_equipo %>"
                                                    data-imei="<%= equipo.IMEI %>"
                                                    data-id_modem="<%= equipo.ID_modem %>"
                                                    data-bs-dismiss="modal">
                                                    Seleccionar
                                                </button>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="4" class="text-center py-5">
                                            <div class="mb-3 text-muted">
                                                <i class="bi bi-inbox fs-1 d-block mb-2 opacity-50"></i>
                                                No hay equipos disponibles en inventario.
                                            </div>
                                            <a href="/registro_equipos" class="btn btn-sm btn-primary rounded-pill px-4">
                                                <i class="bi bi-plus-lg me-1"></i> Ir a Registrar Equipo
                                            </a>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalSeleccionAccesorio" tabindex="-1" aria-labelledby="assignment-accessory-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-lg">
                <div class="modal-header border-0 pb-0">
                    <h5 id="assignment-accessory-title" class="modal-title fw-bold ms-2">
                        <i class="bi bi-plug me-2"></i>Agregar Accesorio
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body pt-3">
                    <p class="text-muted small mb-3">Seleccione el accesorio para vincular a la unidad actual.</p>

                    <div class="table-responsive rounded-3 border" style="max-height: 300px; overflow-y: auto;">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light sticky-top">
                                <tr>
                                    <th class="ps-3">Tipo/Nombre</th>

                                    <th class="text-end pe-3">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if(typeof accesoriosDisponibles !== 'undefined' && accesoriosDisponibles.length > 0) { %>
                                    <% accesoriosDisponibles.forEach(acc => { %>
                                        <tr>
                                            <td class="ps-3 fw-medium">
                                                <%= acc.Nombre_accesorio %>
                                            </td>

                                            <td class="text-end pe-3">
                                                <button class="btn btn-outline-success rounded-pill btn_agregar_accesorio_modal"
                                                    data-id="<%= acc.ID_accesorio_modelo %>"
                                                    data-nombre="<%= acc.Nombre_accesorio %>"
                                                    >
                                                    <i class="bi bi-plus-lg"></i> Agregar
                                                </button>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="3" class="text-center py-4 text-muted">
                                            No hay accesorios disponibles en stock.
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
