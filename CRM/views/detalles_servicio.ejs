<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detalle de Servicio #<%= ticket.ID_ticket %></title>
    <link href="/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.3/dist/sweetalert2.min.css">
    <script nonce="<%= cspNonce %>" src="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.3/dist/sweetalert2.min.js"></script>
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/assignments.css">
    <link rel="stylesheet" href="/css/ticket-workspace.css">
    <link rel="stylesheet" href="/leaflet/leaflet.css">
    <link rel="stylesheet" href="/css/location-map.css">
    <style nonce="<%= cspNonce %>">
        .card-detail {
            border: none;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            transition: transform 0.2s;
        }
        .label-text {
            color: #6c757d;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
        }
        .value-text {
            font-size: 1.1rem;
            font-weight: 500;
            color: #2c3e50;
        }

        .status-border {
            border-left: 5px solid #0d6efd;
        }
        .status-espera { border-left-color: #ffc107; }
        .status-seguimiento { border-left-color: #0dcaf0; }
        .status-finalizado { border-left-color: #198754; }
@media print {
        @page {
            size: letter;
            margin: 0; /* Sin márgenes del navegador */
        }

        /* TRUCO 1: Ocultar todo con display:none para que NO ocupe espacio */
        body > *:not(#printable-area) {
            display: none !important;
        }

        /* TRUCO 2: Bloquear el scroll y altura del body */
        html, body {
            height: 100vh;
            overflow: hidden !important;
            margin: 0 !important;
            padding: 0 !important;
            background: white !important;
        }

        #printable-area {
            display: flex !important;
            flex-direction: column;

            /* Posicionamiento fijo para "planchar" el contenido en la hoja */
            position: fixed;
            top: 0;
            left: 0;

            width: 100%;
            height: 100%; /* Ocupar exactamente la ventana disponible */

            padding: 1.5cm;
            box-sizing: border-box;
            background: white;
            z-index: 9999;
        }

        /* Ajuste de elementos internos para que sean visibles */
        #printable-area * {
            visibility: visible;
        }

        /* --- Diseño Interno (Igual que antes) --- */
        .print-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #000;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }

        .print-logo-box {
            width: 120px;
            height: 50px;
            border: 1px dashed #ccc;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ccc;
            font-size: 10px;
            background: #f9f9f9;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
            font-size: 11px;
        }

        .info-box { border: 1px solid #ddd; padding: 10px; border-radius: 4px; }
        .info-title { font-weight: bold; text-transform: uppercase; font-size: 9px; color: #555; margin-bottom: 5px; border-bottom: 1px solid #eee; padding-bottom: 3px; }

        .print-table { width: 100%; border-collapse: collapse; font-size: 10px; margin-bottom: 15px; }
        .print-table th { background-color: #f4f4f4 !important; border: 1px solid #000; padding: 5px; text-transform: uppercase; font-size: 9px; }
        .print-table td { border: 1px solid #ccc; padding: 5px; vertical-align: top; }

        .obs-box { border: 1px solid #ddd; padding: 8px; font-size: 10px; background: #fdfdfd; margin-bottom: 10px; }

        /* Firmas: Empujadas al fondo automáticamente */
        .signature-wrapper {
            margin-top: auto;
            display: flex;
            justify-content: space-between;
            padding-top: 10px;
            page-break-inside: avoid;
        }
        .signature-box { width: 40%; text-align: center; }
        .signature-line { border-bottom: 1px solid #000; height: 1px; margin-bottom: 8px; }

        .footer-legal { text-align: center; margin-top: 10px; font-size: 8px; color: #999; }
        a { text-decoration: none; color: #000; }
    }
    </style>
    <link rel="stylesheet" href="/css/theme-dark.css">
<meta name="csrf-token" content="<%= csrfToken %>"></head>
<body class="bg-light" data-ticket-workspace="<%= canAssign %>" data-ticket-list-return="<%= backToTickets %>">

<div class="container-fluid ticket-detail-page assignment-page px-3 px-lg-4 py-4">
    <%- include('partials/session-bar') %>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-0">Detalle del Servicio</h2>
            <p class="text-muted">Gestión de Ticket de Soporte</p>
        </div>
        <a href="<%= backToTickets %>" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver a Tickets
        </a>
    </div>

    <% if (ticket.Estatus_servicio === 'Finalizado') { %><p class="alert alert-success" id="ticket-closed-at"><strong>Cierre del servicio:</strong> <%= ticket.Fecha_cierre ? new Date(ticket.Fecha_cierre).toLocaleString('es-MX',{timeZone:'America/Mexico_City'}) + ' · Ciudad de México' : 'Fecha no registrada.' %></p><% } %>
    <section class="soft-card mb-4 ticket-preparation" aria-labelledby="preparation-title">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div><h2 class="h5" id="preparation-title">Preparación del servicio</h2><p class="mb-0 text-muted"><%= preparation.registered %> de <%= preparation.planned %> unidades registradas · <%= preparation.equipped %> de <%= preparation.planned %> con equipo</p></div>
        <% if (canAssign) { %><a id="ticket-next-action" class="btn btn-primary" href="<%= preparation.complete ? '#ticket-close-actions' : '#assignment-workspace' %>"><%= preparation.complete ? 'Revisar y finalizar' : ticket.Estatus_servicio === 'En espera' ? 'Registrar unidades' : 'Asignar equipos y accesorios' %></a><% } else { %><span class="badge text-bg-success"><%= ticket.Estatus_servicio === 'Finalizado' ? 'Servicio finalizado · Consulta del historial' : 'Consulta del servicio · Preparación a cargo de coordinación' %></span><% } %>
      </div>
      <div class="progress mt-3" role="progressbar" aria-label="Preparación de unidades y equipos" aria-valuenow="<%= preparation.percent %>" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width:<%= preparation.percent %>%"><%= preparation.percent %>%</div></div>
      <ol class="assignment-steps mt-3 mb-0"><li id="assignment-step-units" class="<%= preparation.registered === preparation.planned && preparation.planned > 0 ? 'complete' : 'active' %>">1. Registrar unidades</li><li id="assignment-step-equipment" class="<%= preparation.complete ? 'complete' : ticket.Estatus_servicio === 'En seguimiento' ? 'active' : '' %>">2. Equipos y accesorios</li><li id="assignment-step-ready" class="<%= preparation.complete ? 'complete' : '' %>">3. Asignación completa</li></ol>
      <% if (canAssign && !ticket.Tecnico) { %><p class="small mt-3 mb-0">Técnico pendiente. <a href="#ticket-technician">Completar asignación</a></p><% } %>
      <nav class="d-flex flex-wrap gap-2 mt-3" aria-label="Secciones del ticket"><a class="btn btn-outline-secondary" href="#ticket-information">Información</a><a class="btn btn-outline-secondary" href="<%= canAssign ? '#assignment-workspace' : '#ticket-units-history' %>">Unidades y equipos</a><a class="btn btn-outline-secondary" href="#ticket-evidence">Evidencias</a><a class="btn btn-outline-secondary" href="#ticket-history">Historial</a></nav>
    </section>

    <div class="card card-detail status-border
        <%= ticket.Estatus_servicio === 'En espera' ? 'status-espera' :
           (ticket.Estatus_servicio === 'Finalizado' ? 'status-finalizado' : 'status-seguimiento') %>">

        <div class="card-body p-3 p-lg-4" id="ticket-information">

            <div class="d-flex justify-content-between align-items-start mb-4 border-bottom pb-3">
                <div>
                    <span class="badge bg-dark mb-2">ID: #<%= ticket.ID_ticket %></span>
                    <h3 class="card-title text-primary"><%= ticket.Tipo_servicio %></h3>
                </div>
                <div class="text-end">
                    <span class="label-text d-block">Estatus Actual</span>
                    <%
                        let badgeClass = 'bg-secondary';
                        if(ticket.Estatus_servicio === 'En espera') badgeClass = 'bg-warning text-dark';
                        if(ticket.Estatus_servicio === 'En seguimiento') badgeClass = 'bg-info text-dark';
                        if(ticket.Estatus_servicio === 'Finalizado') badgeClass = 'bg-success';
                    %>
                    <span class="badge <%= badgeClass %> fs-6 px-3 py-2 rounded-pill">
                        <%= ticket.Estatus_servicio %>
                    </span>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-md-6 border-end-md">
                    <h5 class="mb-3 text-secondary">Información del servicio</h5>

                    <div class="mb-3">
                        <label class="label-text">Cliente / Empresa</label>
                        <div class="value-text">
                            <%= ticket.Cliente ? ticket.Cliente.Nombre_empresa : 'ID: ' + ticket.ID_cliente %>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="label-text">Técnico Asignado</label>
                        <div class="d-flex flex-wrap align-items-center gap-2" id="ticket-technician">
                            <div class="value-text">
                                <%= ticket.Tecnico ? ticket.Tecnico.Nombre_tecnico : 'Tecnico pendiente de asignacion' %>
                            </div>
                            <% if (canAssign) { %><button type="button" class="btn btn-outline-primary ms-3" data-bs-toggle="modal" data-bs-target="#modalAsignarTecnico"><%= ticket.Tecnico ? 'Cambiar técnico' : 'Asignar técnico' %></button><% } %>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="label-text">Fecha y Hora de Servicio</label>
                        <div class="value-text">
                            <% if (ticket.Fecha_servicio) { %>
                            <div>
                                <i class="bi bi-calendar-event me-2 text-primary"></i>
                                <%= new Date(ticket.Fecha_servicio).toLocaleDateString('es-MX', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
                            </div>
                            <div class="mt-1 text-muted small" style="font-size: 0.95rem;">
                                <i class="bi bi-clock me-2 text-primary"></i>
                                <%= new Date(ticket.Fecha_servicio).toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit', hour12: true }) %>
                            </div>
                            <% } else { %>
                                Fecha pendiente de programación
                            <% } %>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 ps-md-4">
                    <h5 class="mb-3 text-secondary">Unidades y ubicación</h5>

                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="label-text">Unidades a Atender</label>
                            <div class="value-text fs-4 fw-bold text-dark">
                                <%= ticket.Numero_unidades %>
                            </div>
                        </div>
                        <div class="col-6 mb-3">
                            <label class="label-text">Asignacion de Equipos</label>
                            <div>
                                <% if(ticket.Estatus_unidades == 1) { %>
                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> Asignados </span>
                                <% } else { %>
                                    <span class="badge bg-danger"><i class="bi bi-exclamation-circle"></i> Pendientes</span>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <section class="ticket-location-panel" aria-labelledby="ticket-location-heading">
                      <h3 class="h6 mb-2" id="ticket-location-heading">Ubicación del servicio</h3>
                      <% if (!ticket.Link_maps) { %><input type="hidden" id="inputLinkMaps" value=""><% } %>
                      <%- include('partials/location-picker', { inputId: 'inputLinkMaps', readonly: true }) %>
                      <div class="ticket-location-actions mt-3">
                        <% if (canAssign) { %><button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalEditarMaps"><%= ticket.Link_maps ? 'Editar ubicación' : 'Agregar ubicación' %></button><% } %>
                        <% if (safeMapsHref) { %><a id="inputLinkMaps-open" href="<%= safeMapsHref %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary">Abrir en Maps <span aria-hidden="true">↗</span></a><% } %>
                      </div>
                      <% if (ticket.Link_maps) { %>
                      <details class="ticket-location-source mt-3"><summary>Ver enlace de ubicación</summary><label class="visually-hidden" for="inputLinkMaps">Enlace guardado</label><div class="d-flex flex-wrap gap-2 mt-2"><input type="text" class="form-control bg-light" id="inputLinkMaps" value="<%= ticket.Link_maps %>" readonly><button class="btn btn-outline-secondary" type="button" data-ticket-action="copy-location">Copiar enlace</button></div></details>
                      <% } %>
                    </section>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0 text-secondary"><i class="bi bi-chat-left-text-fill me-2"></i>Comentarios y Observaciones</h5>

                    <%
                       const estatusCom = ticket.Estatus_servicio ? ticket.Estatus_servicio.trim() : '';
                       if (canManage && (estatusCom === 'En espera' || estatusCom === 'En seguimiento')) {
                    %>
                        <button class="btn btn-sm btn-outline-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#modalComentarios">
                            <i class="bi bi-pencil-square me-1"></i> Editar
                        </button>
                    <% } %>
                </div>

                <div class="p-3 bg-light rounded border border-light">
                    <% if(ticket.Comentarios) { %>
                        <p class="mb-0 text-dark"><%= ticket.Comentarios %></p>
                    <% } else { %>
                        <p class="mb-0 text-muted fst-italic">No hay comentarios adicionales para este servicio.</p>
                    <% } %>
                </div>
            </div>
            <% if (canAssign) { %>
            <div class="mt-4 pt-3 border-top" id="ticket-assignment-section">
              <h2 class="h5 mb-3" id="ticket-assignment-title">Unidades, equipos y accesorios</h2>
              <div id="ticket-assignment-context" hidden data-id_ticket="<%= ticket.ID_ticket %>" data-cliente="<%= ticket.Cliente?.Nombre_empresa ?? 'Sin cliente' %>" data-num_unidades="<%= ticket.Numero_unidades %>" data-stage="<%= ticket.Estatus_servicio === 'En espera' ? 'units' : 'equipment' %>"></div>
              <div id="ticket-assignment-error" class="alert alert-warning d-none" role="alert"><span></span> <button type="button" class="btn btn-outline-primary" id="ticket-assignment-retry">Reintentar</button></div>
              <fieldset id="ticket-assignment-fields" class="border-0 p-0 m-0" disabled><legend class="visually-hidden">Preparación de unidades y equipos del ticket</legend><%- include('partials/assignment-workspace', { embedded: true }) %></fieldset>
            </div>
            <% } else { %>
            <div class="mt-4 pt-3 border-top" id="ticket-units-history">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="text-secondary mb-0"><i class="bi bi-truck-front-fill me-2"></i>Unidades y Equipos Asignados</h5>
                </div>

                <% if (ticket.Unidades && ticket.Unidades.length > 0) { %>
                    <div class="table-responsive rounded-3 border">
                        <table class="table table-hover align-middle mb-0 ticket-assigned-units">
                            <thead class="bg-light text-secondary small text-uppercase">
                                <tr>
                                    <th class="ps-3 border-0">Unidad</th>
                                    <th class="border-0">Identificadores</th>
                                    <th class="border-0">Equipo GPS</th>
                                    <th class="border-0">Accesorios</th>
                                    <th class="border-0 text-end pe-3">Estado / Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% ticket.Unidades.forEach(unidad => { %>
                                    <tr>
                                        <td class="ps-3" data-label="Unidad">
                                            <div class="d-flex align-items-center">
                                                <div class="rounded-circle bg-light p-2 me-2 text-primary">
                                                    <i class="bi bi-car-front"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-bold text-dark">
                                                        <%= unidad.Unidad_stock ? unidad.Unidad_stock.Modelo_unidad : 'Modelo N/D' %>
                                                    </div>
                                                    <small class="text-muted">
                                                        <%= unidad.Unidad_stock ? unidad.Unidad_stock.Marca_unidad : 'Marca N/D' %>
                                                    </small>
                                                </div>
                                            </div>
                                        </td>

                                        <td data-label="Identificadores">
                                            <div class="d-flex flex-column gap-1">
                                                <div class="small text-muted font-monospace">Placa:</div>
                                                <span class="badge bg-white text-dark border fw-normal text-start">
                                                    <i class="bi bi-card-text me-1 text-muted"></i> <%= unidad.Placa_unidad || 'S/P' %>
                                                </span>
                                                <div class="small text-muted font-monospace">VIN:</div>
                                                <span class="badge bg-white text-dark border fw-normal text-start">
                                                    <i class="bi bi-upc-scan me-1 text-muted"></i> <%= unidad.Vin_unidad || 'S/V' %>
                                                </span>
                                            </div>
                                        </td>

                                        <td data-label="Equipo GPS">
                                            <% if (unidad.Equipo) { %>
                                                <div class="d-flex justify-content-between align-items-center bg-light border rounded p-2" style="max-width: 220px;">
                                                    <div class="text-primary overflow-hidden">
                                                        <div class="fw-medium text-truncate">
                                                            <i class="bi bi-cpu-fill me-1"></i>
                                                            <%= unidad.Equipo.Equipo_stock ? unidad.Equipo.Equipo_stock.Modelo_equipo : 'GPS' %>
                                                        </div>
                                                        <div class="small text-muted font-monospace">
                                                            IMEI: <%= unidad.Equipo.IMEI %>
                                                        </div>
                                                    </div>

                                                    <% if (canManage && ticket.Estatus_servicio !== 'Finalizado') { %>
                                                        <button class="btn btn-sm btn-outline-danger border-0 ms-2"
                                                                title="Desvincular GPS"
                                                                data-ticket-action="release-equipment" data-unit-id="<%= unidad.ID_unidad %>" data-equipment-id="<%= unidad.Equipo.ID_equipo %>" data-ticket-id="<%= ticket.ID_ticket %>">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    <% } %>
                                                </div>
                                            <% } else { %>
                                                <span class="text-muted fst-italic small">
                                                    <i class="bi bi-dash-circle me-1"></i>Sin equipo
                                                </span>
                                            <% } %>
                                        </td>

                                        <td class="assigned-unit-accessories" style="min-width: 200px;" data-label="Accesorios">
                                            <% if (unidad.Accesorio_stocks && unidad.Accesorio_stocks.length > 0) { %>
                                                <div class="d-flex flex-column gap-2 align-items-start py-1">
                                                    <% unidad.Accesorio_stocks.forEach(acc => { %>
                                                        <span class="badge bg-white text-secondary border shadow-sm d-inline-flex align-items-center justify-content-between"
                                                            style="min-width: 160px; max-width: 100%;">
                                                            <span class="text-truncate me-2">
                                                                <i class="bi bi-plug-fill me-1 text-warning"></i>
                                                                <%= acc.Nombre_accesorio %>
                                                            </span>

                                                            <% if (canManage && ticket.Estatus_servicio !== 'Finalizado') { %>
                                                                <i class="bi bi-x-circle-fill text-danger cursor-pointer flex-shrink-0"
                                                                style="cursor: pointer;"
                                                                title="Quitar accesorio"
                                                                data-ticket-action="remove-accessory" data-unit-id="<%= unidad.ID_unidad %>" data-accessory-id="<%= acc.ID_accesorio_modelo %>">
                                                                </i>
                                                            <% } %>
                                                        </span>
                                                    <% }) %>
                                                </div>
                                            <% } else { %>
                                                <span class="text-muted small fst-italic">-</span>
                                            <% } %>
                                        </td>

                                        <td class="text-end pe-3" data-label="Estado / Acciones">
                                            <% if (unidad.Equipo) { %>
                                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">
                                                    <i class="bi bi-check-circle me-1"></i><%= unidad.Equipo.Estatus_equipo === 'Instalado' ? 'Equipo Instalado' : unidad.Equipo.Estatus_equipo === 'Asignado' ? 'Equipo Asignado' : 'Equipo Disponible' %>
                                                </span>
                                            <% } else { %>
                                                <% if (canManage && ticket.Estatus_servicio !== 'Finalizado') { %>
                                                    <a href="#assignment-workspace" class="btn btn-sm btn-primary rounded-pill px-3">
                                                        <i class="bi bi-plus-lg"></i> Asignar Equipo
                                                    </a>
                                                <% } else { %>
                                                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3">
                                                        <i class="bi bi-dash-circle me-1"></i>Finalizado
                                                    </span>
                                                <% } %>
                                            <% } %>
                                            <% if (canManage && ticket.Estatus_servicio === 'En seguimiento') { %>
                                                <div class="mt-2"><button type="button" class="btn btn-outline-danger" style="min-height:44px" data-ticket-action="remove-unit" data-last-unit="<%= ticket.Unidades.length === 1 %>" data-unit-id="<%= unidad.ID_unidad %>" data-ticket-id="<%= ticket.ID_ticket %>" data-unit-label="<%= unidad.Placa_unidad || unidad.Vin_unidad || ('#' + unidad.ID_unidad) %>">Quitar unidad</button></div>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="alert alert-light border-0 d-flex align-items-center text-muted" role="alert">
                        <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                        <div>
                            No hay unidades asignadas a este ticket.
                            <% if (canManage && ticket.Estatus_servicio !== 'Finalizado') { %>
                                <a href="#assignment-workspace" class="fw-bold text-decoration-none ms-1">Ir a Asignar Unidades</a>.
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </div>
            <% } %>
            <div class="row mt-4" id="ticket-evidence">
                <div class="col-12">
                    <div class="soft-card">
                        <h5 class="mb-4">Evidencia del Servicio</h5>

                        <div class="d-flex flex-wrap gap-3 mb-4">
                            <% if (ticket.TicketFotos && ticket.TicketFotos.length > 0) { %>
                                <% ticket.TicketFotos.forEach(foto => { %>
                                    <div class="position-relative">
                                        <img src="<%= foto.Ruta_archivo %>" class="rounded-4 shadow-sm"
                                            style="width: 100px; height: 100px; object-fit: cover; border: 2px solid white;">
                                        <a href="<%= foto.Ruta_archivo %>" target="_blank" class="position-absolute top-0 end-0 m-1 bg-white rounded-circle p-1 text-primary shadow-sm" style="font-size: 10px;">
                                            <i class="bi bi-arrows-fullscreen"></i>
                                        </a>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <p class="text-muted fst-italic w-100">No hay evidencia fotográfica cargada aún.</p>
                            <% } %>
                        </div>
                        <% if (canManage && ticket.Estatus_servicio !== 'Finalizado') { %>
                            <div class="mt-4 p-3 bg-white rounded-4 shadow-sm border">
                                <h6 class="mb-3 fw-bold text-muted">Agregar Nueva Evidencia</h6>

                                <form action="/tickets/<%= ticket.ID_ticket %>/subir-fotos" method="POST" enctype="multipart/form-data" id="formSubida"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="returnTo" value="<%= backToTickets %>">
                                    <input type="file" name="fotos" id="inputFotosReal" multiple accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" class="d-none">
                                    <div class="d-flex gap-2 align-items-center mb-3">
                                        <button type="button" class="btn btn-outline-primary rounded-pill px-4" data-ticket-action="select-photos">
                                            <i class="bi bi-images me-2"></i> Seleccionar Fotos
                                        </button>
                                        <small class="text-muted" id="conteoArchivos">0 archivos seleccionados</small>
                                    </div>
                                    <div id="previewContainer" class="d-flex flex-wrap gap-3 mb-3"></div>
                                    <button type="submit" id="btnSubirReal" class="btn btn-success rounded-pill px-4 w-100 d-none" style="background-color: var(--pastel-green-text); border:none;">
                                        <i class="bi bi-cloud-upload-fill me-2"></i> Subir Imágenes Seleccionadas
                                    </button>
                                </form>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

    </div>
    <%- include('partials/ticket-history') %>
        <div id="ticket-close-actions" class="soft-card mt-4 d-flex flex-wrap justify-content-end gap-2" role="group" aria-label="Acciones del ticket">

            <button class="btn btn-outline-secondary" data-ticket-action="print">
                <i class="bi bi-printer"></i> Imprimir Ticket
            </button>

            <%
                const estatus = ticket.Estatus_servicio ? ticket.Estatus_servicio.trim().toLowerCase() : '';
            %>
            <% if (estatus === 'en espera' || estatus === 'en seguimiento') { %>
                <button data-ticket-action="complete" <%= preparation.complete ? '' : 'disabled' %> title="<%= preparation.complete ? 'Finalizar servicio' : 'Completa las unidades y sus equipos para finalizar' %>" data-ticket-id="<%= ticket.ID_ticket %>" data-photo-count="<%= ticket.TicketFotos ? ticket.TicketFotos.length : 0 %>" class="btn btn-success">
                    <i class="bi bi-check-circle-fill me-2"></i> Finalizar Servicio
                </button>
            <% } %>

            <% if (canManage && ticket.Estatus_servicio === 'Finalizado') { %>
                <button data-ticket-action="reopen" data-ticket-id="<%= ticket.ID_ticket %>" class="btn btn-outline-dark">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Reabrir Ticket
                </button>
            <% } %>

        </div>
</div>

<% if (canManage) { %>
<div class="modal fade" id="modalComentarios" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Editar Comentarios</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form action="/tickets/actualizar_comentarios" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="returnTo" value="<%= backToTickets %>">
                <div class="modal-body">
                    <input type="hidden" name="ID_ticket" value="<%= ticket.ID_ticket %>">
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Comentarios y Observaciones</label>
                        <textarea class="form-control bg-light" name="Comentarios" rows="5"><%= ticket.Comentarios %></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary rounded-pill">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modalAsignarTecnico" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-info text-white border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-helmet me-2"></i>Asignar Técnico</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form action="/tickets/asignar_tecnico" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="returnTo" value="<%= backToTickets %>">
                <div class="modal-body p-4">
                    <input type="hidden" name="ID_ticket" value="<%= ticket.ID_ticket %>">

                    <p class="text-muted mb-3">Selecciona el técnico responsable para este servicio.</p>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Técnico Disponible</label>
                        <select class="form-select form-select-lg" name="ID_tecnico" required>
                            <option value="" selected disabled>-- Seleccionar --</option>
                            <% if(typeof tecnicos !== 'undefined' && tecnicos.length > 0) { %>
                                <% tecnicos.forEach(tec => { %>
                                    <% if(tec.Estatus_tecnico === 'Activo') { %>
                                        <option value="<%= tec.ID_Tecnico %>"><%= tec.Nombre_tecnico %></option>
                                    <% } %>
                                <% }) %>
                            <% } else { %>
                                <option value="" disabled>No se cargó la lista de técnicos (Revisar Controlador)</option>
                            <% } %>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-info text-white rounded-pill px-4">Confirmar Asignación</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modalEditarMaps" tabindex="-1" aria-labelledby="location-edit-title" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-primary" id="location-edit-title">
                    <i class="bi bi-geo-alt me-2"></i>Actualizar Ubicación
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <form action="/tickets/actualizar_maps" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="returnTo" value="<%= backToTickets %>">
                <div class="modal-body pt-4">
                    <input type="hidden" name="ID_ticket" value="<%= ticket.ID_ticket %>">

                    <p class="text-muted small">Pega un enlace de Maps o selecciona el punto del servicio. Deja el campo vacío si está pendiente.</p>

                    <div class="mb-3">
                        <label class="form-label" for="location-edit-link">Enlace de Maps</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-globe"></i></span>
                            <input type="text" class="form-control bg-light border-0" id="location-edit-link" maxlength="255"
                                   name="Link_maps"
                                   value="<%= ticket.Link_maps || '' %>"
                                   placeholder="https://maps.app.goo.gl/…">
                        </div>
                    </div>
                    <%- include('partials/location-picker', { inputId: 'location-edit-link', readonly: false }) %>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

<% } %>
    <div id="printable-area" style="display: none;">

        <div class="print-header">
            <div class="print-logo-box">
                [LOGO EMPRESA]
            </div>
            <div style="text-align: center; flex-grow: 1;">
                <h2 style="margin: 0; font-size: 18px; font-weight: bold;">ORDEN DE SERVICIO</h2>
                <p style="margin: 0; font-size: 10px;">Comprobante de Instalación y Configuración GPS</p>
            </div>
            <div style="text-align: right;">
                <div style="font-size: 14px; font-weight: bold;">FOLIO: #<%= ticket.ID_ticket %></div>
                <div style="font-size: 10px;">Fecha Impresión: <span id="print-date"></span></div>
            </div>
        </div>

        <div class="info-grid">
            <div class="info-box">
                <div class="info-title">Cliente / Empresa</div>
                <div style="font-weight: bold; font-size: 12px;"><%= ticket.Cliente.Nombre_empresa %></div>
                <div>Contacto: <%= ticket.Cliente.Encargado || 'N/D' %></div>
            </div>

            <div class="info-box">
                <div class="info-title">Datos del Servicio</div>
                <div>Tipo: <strong><%= ticket.Tipo_servicio %></strong></div>
                <div>Técnico: <%= ticket.Tecnico ? ticket.Tecnico.Nombre_tecnico : 'Sin Asignar' %></div>
                <div>Fecha Programada: <%= ticket.Fecha_servicio ? new Date(ticket.Fecha_servicio).toLocaleDateString() : 'Pendiente' %></div>
            </div>

            <div class="info-box">
                <div class="info-title">Estatus & Unidades</div>
                <div>Estado: <%= ticket.Estatus_servicio %></div>
                <div>Unidades Totales: <strong><%= ticket.Numero_unidades %></strong></div>
            </div>
        </div>

        <div style="font-weight: bold; font-size: 11px; margin-bottom: 5px; text-transform: uppercase; border-bottom: 2px solid #000;">
            Detalle de Unidades y Equipos
        </div>

        <table class="print-table">
            <thead>
                <tr>
                    <th style="width: 25%;">Vehículo</th>
                    <th style="width: 25%;">Identificadores</th>
                    <th style="width: 25%;">Equipo GPS (IMEI)</th>
                    <th style="width: 25%;">Accesorios</th>
                </tr>
            </thead>
            <tbody>
                <% if (ticket.Unidades && ticket.Unidades.length > 0) { %>
                    <% ticket.Unidades.forEach(unidad => { %>
                    <tr>
                        <td>
                            <strong><%= unidad.Unidad_stock ? unidad.Unidad_stock.Modelo_unidad : 'N/D' %></strong><br>
                            <span style="font-size: 9px;"><%= unidad.Unidad_stock ? unidad.Unidad_stock.Marca_unidad : '' %></span>
                        </td>
                        <td>
                            Placa: <strong><%= unidad.Placa_unidad || '--' %></strong><br>
                            VIN: <%= unidad.Vin_unidad || '--' %>
                        </td>
                        <td>
                            <% if (unidad.Equipo) { %>
                                <strong><%= unidad.Equipo.Equipo_stock ? unidad.Equipo.Equipo_stock.Modelo_equipo : 'GPS' %></strong><br>
                                <%= unidad.Equipo.IMEI %>
                            <% } else { %>
                                <span style="font-style: italic; color: #777;">Sin Asignar</span>
                            <% } %>
                        </td>
                        <td>
                            <% if (unidad.Accesorio_stocks && unidad.Accesorio_stocks.length > 0) { %>
                                <% unidad.Accesorio_stocks.forEach(acc => { %>
                                    • <%= acc.Nombre_accesorio %><br>
                                <% }) %>
                            <% } else { %>
                                -
                            <% } %>
                        </td>
                    </tr>
                    <% }) %>
                <% } else { %>
                    <tr><td colspan="4" style="text-align: center; padding: 20px;">Sin unidades asignadas.</td></tr>
                <% } %>
            </tbody>
        </table>

        <% if(ticket.Comentarios) { %>
        <div style="border: 1px solid #ddd; padding: 5px; margin-bottom: 20px; font-size: 10px; background: #fdfdfd;">
            <strong>Observaciones:</strong> <%= ticket.Comentarios %>
        </div>
        <% } %>

        <div class="signature-wrapper">
            <div class="signature-box">
                <div class="signature-line"></div>
                <div style="font-weight: bold; font-size: 11px;"><%= ticket.Tecnico ? ticket.Tecnico.Nombre_tecnico : 'Técnico' %></div>
                <div style="font-size: 9px; color: #555;">Firma del Técnico</div>
            </div>

            <div class="signature-box">
                <div class="signature-line"></div>
                <div style="font-weight: bold; font-size: 11px;"><%= ticket.Cliente.Nombre_contacto || 'Cliente' %></div>
                <div style="font-size: 9px; color: #555;">Firma de Conformidad</div>
            </div>
        </div>

        <div style="text-align: center; margin-top: 15px; font-size: 8px; color: #999;">
            El cliente acepta que los servicios descritos han sido recibidos a entera satisfacción. <br>
            Generado por CRM TSV.
        </div>
    </div>


    <% if (canAssign) { %><%- include('partials/assignment-equipment-modals') %><% } %>
    <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/leaflet/leaflet.js"></script>

    <script type="module" src="/assets/pages/ticket-details.js"></script>
</body>
</html>
