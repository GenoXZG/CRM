  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const nonce = pm.response.headers.all().filter(h => h.key.toLowerCase() === \"set-cookie\").map(h => h.value).find(v => /^(?:__Host-)?crm_csrf=/.test(v));",
          "if (nonce) pm.collectionVariables.set(\"csrfNonce\", nonce.split(\";\")[0]);",
          "const path = pm.variables.replaceIn(pm.request.url.toString());",
          "if (/\\/login(?:\\/verificar)?$/.test(path)) return;",
          "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
          "const name = pm.info.requestName;",
          "const contentType = pm.response.headers.get(\"Content-Type\") || \"\";",
          "if (name === \"Health\") {",
          "  pm.test(\"Database available\", function () { pm.expect(pm.response.json().status).to.eql(\"ok\"); });",
          "} else if (name.startsWith(\"Page \")) {",
          "  pm.test(\"HTML page\", function () { pm.expect(contentType).to.include(\"text/html\"); pm.expect(pm.response.text()).to.include(\"<html\"); });",
          "} else if (name.startsWith(\"Module \") || name === \"Bootstrap JavaScript\") {",
          "  pm.test(\"JavaScript content\", function () { pm.expect(contentType).to.include(\"javascript\"); });",
          "} else if (name.startsWith(\"Stylesheet \")) {",
          "  pm.test(\"CSS content\", function () { pm.expect(contentType).to.include(\"text/css\"); });",
          "} else if (name === \"Resolve coordinate link\") {",
          "  pm.test(\"Resolved map coordinates\", function () { const result = pm.response.json(); pm.expect(result.success).to.eql(true); pm.expect(result.data.lat).to.eql(19.406313); pm.expect(result.data.lng).to.eql(-99.04689); pm.expect(result.data.normalizedUrl).to.eql(\"https://www.google.com/maps?q=19.406313,-99.046890\"); });",
          "} else {",
          "  pm.test(\"JSON array\", function () { pm.expect(contentType).to.include(\"application/json\"); pm.expect(pm.response.json()).to.be.an(\"array\"); });",
          "}",
          "if (name === \"Unit brands\") {",
          "  const brands = pm.response.json();",
          "  pm.test(\"Brand available for model lookup\", function () { pm.expect(brands.length).to.be.above(0); });",
          "  if (brands.length) pm.collectionVariables.set(\"brand\", encodeURIComponent(brands[0].Marca_unidad));",
          "}"
        ]
      }
    },
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const path = pm.variables.replaceIn(pm.request.url.toString());",
          "const verify = path.includes(\"/login/verificar\");",
          "const session = pm.collectionVariables.get(verify ? \"pendingCookie\" : \"sessionCookie\");",
          "if (session) pm.request.headers.upsert({ key: \"Cookie\", value: session });",
          "if (![\"GET\", \"HEAD\", \"OPTIONS\"].includes(pm.request.method)) {",
          "  const base = pm.variables.replaceIn(\"{{baseUrl}}\").replace(/\\/$/, \"\");",
          "  const scope = path.includes(\"/login/recuperar\") ? \"/login/recuperar\" : path.includes(\"/login\") ? \"/login\" : \"\";",
          "  const storedNonce = pm.collectionVariables.get(\"csrfNonce\");",
          "  const previousCookies = [session, storedNonce].filter(Boolean).join(\"; \");",
          "  pm.sendRequest({ url: base + scope + \"/csrf-token\", header: previousCookies ? { Cookie: previousCookies } : {} }, (error, response) => {",
          "    if (error || response.code !== 200) throw new Error(\"No se obtuvo el token CSRF\");",
          "    const cookie = response.headers.all().filter(h => h.key.toLowerCase() === \"set-cookie\").map(h => h.value).find(v => /^(?:__Host-)?crm_csrf=/.test(v));",
          "    const nonce = cookie ? cookie.split(\";\")[0] : storedNonce;",
          "    if (nonce) {",
          "      pm.collectionVariables.set(\"csrfNonce\", nonce);",
          "      pm.request.headers.upsert({ key: \"Cookie\", value: [session, nonce].filter(Boolean).join(\"; \") });",
          "    }",
          "    pm.request.headers.upsert({ key: \"X-CSRF-Token\", value: response.json().token });",
          "  });",
          "}"
        ]
      }
    }
  ]
}
