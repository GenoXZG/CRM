  "item": [
    {
      "name": "1. Login — enviar código",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/login",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "correo",
              "value": "{{authEmail}}"
            },
            {
              "key": "password",
              "value": "{{authPassword}}"
            }
          ]
        }
      },
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Segundo factor requerido\", function () { pm.expect(pm.response.code).to.equal(302); pm.expect(pm.response.headers.get(\"Location\")).to.equal(\"/login/verificar\"); });",
              "pm.collectionVariables.unset(\"sessionCookie\");",
              "const cookie = pm.response.headers.all().filter(h => h.key.toLowerCase() === \"set-cookie\").map(h => h.value).find(v => v.startsWith(\"crm_pending=\"));",
              "if (cookie) pm.collectionVariables.set(\"pendingCookie\", cookie.split(\";\")[0]);",
              "else pm.collectionVariables.unset(\"pendingCookie\");"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Verificar código — completar authCode con el correo recibido",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/login/verificar",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "code",
              "value": "{{authCode}}"
            }
          ]
        }
      },
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Verificación correcta\", function () { pm.expect(pm.response.code).to.equal(302); pm.expect(pm.response.headers.get(\"Location\")).to.equal(\"/\"); });",
              "const cookie = pm.response.headers.all().filter(h => h.key.toLowerCase() === \"set-cookie\").map(h => h.value).find(v => v.startsWith(\"crm_session=\") && !v.includes(\"Max-Age=0\"));",
              "if (pm.response.code === 302 && cookie) { pm.collectionVariables.set(\"sessionCookie\", cookie.split(\";\")[0]); pm.collectionVariables.unset(\"pendingCookie\"); pm.collectionVariables.unset(\"authCode\"); }"
            ]
          }
        }
      ]
    },
