    {
      "name": "Exportar tickets CSV (filtros aplicados)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tickets/exportar?status=completed",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tickets",
            "exportar"
          ],
          "query": [
            {
              "key": "status",
              "value": "completed"
            }
          ]
        },
        "description": "Requiere login y verificación 2FA previos (cookie de sesión). Descarga todos los resultados filtrados; ignora página y tamaño. Técnicos: únicamente servicios propios. Usar Send and Download para guardar el CSV. Filtros opcionales: search, attention, status, client, technician, dateFrom, dateTo."
      },
      "response": []
    }
