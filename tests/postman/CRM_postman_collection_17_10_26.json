    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Pages",
      "item": [
        {
          "name": "Page /",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const html = pm.response.text();",
                  "pm.test(\"Guía: elementos clave\", function () {",
                  "  ['id=\"crmSetupAssistant\"', 'id=\"setupClose\"', 'id=\"setupSkipAll\"', 'id=\"setupReset\"', '/js/setup-wizard.js'].forEach(function (t) { pm.expect(html).to.include(t); });",
                  "});",
                  "pm.test(\"Guía: ya no existe 'Omitir por ahora'\", function () {",
                  "  pm.expect(html).to.not.include('data-defer-ticket');",
                  "  pm.expect(html).to.not.include('Omitir por ahora');",
                  "});",
                  "pm.test(\"Guía: pesos suman 100\", function () {",
                  "  const w = [...html.matchAll(/data-setup-weight=\"(\\d+)\"/g)].map(function (m) { return Number(m[1]); });",
                  "  pm.expect(w).to.have.lengthOf(6);",
                  "  pm.expect(w.reduce(function (a, b) { return a + b; }, 0)).to.eql(100);",
                  "});",
                  "pm.test(\"Guía: contador numérico por paso\", function () {",
                  "  const c = [...html.matchAll(/data-setup-item=\"(\\w+)\"[^>]*data-setup-count=\"(\\d+)\"/g)].map(function (m) { return m[1]; });",
                  "  pm.expect(c).to.have.members(['clients', 'technicians', 'equipment', 'units', 'accessories']);",
                  "});"
                ]
              }
            }
          ]
        },
