                  "const t = pm.response.text();",
                  "pm.test(\"Guía: lógica presente\", function () {",
                  "  ['crmSetupAssistant', 'setupReset', 'crmSetupBaselineV1'].forEach(function (k) { pm.expect(t).to.include(k); });",
