{
  "info": {
    "name": "CRM read-only checks",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3031"
    },
    {
      "key": "ticketId",
      "value": "2"
    },
    {
      "key": "brand",
      "value": ""
    }
