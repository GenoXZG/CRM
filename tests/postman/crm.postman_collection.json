  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
          "const name = pm.info.requestName;",
          "const contentType = pm.response.headers.get(\"Content-Type\") || \"\";",
          "if (name === \"Health\") {",
          "  pm.test(\"Database available\", function () { pm.expect(pm.response.json().status).to.eql(\"ok\"); });",
          "} else if (name.startsWith(\"Page \")) {",
          "  pm.test(\"HTML page\", function () { pm.expect(contentType).to.include(\"text/html\"); pm.expect(pm.response.text()).to.include(\"<html\"); });",
          "} else if (name.startsWith(\"Module \") || name === \"Bootstrap JavaScript\") {",
          "  pm.test(\"JavaScript content\", function () { pm.expect(contentType).to.include(\"javascript\"); });",
          "} else if (name.startsWith(\"Stylesheet \")) {",
          "  pm.test(\"CSS content\", function () { pm.expect(contentType).to.include(\"text/css\"); });",
          "} else {",
          "  pm.test(\"JSON array\", function () { pm.expect(contentType).to.include(\"application/json\"); pm.expect(pm.response.json()).to.be.an(\"array\"); });",
          "}",
          "if (name === \"Unit brands\") {",
          "  const brands = pm.response.json();",
          "  pm.test(\"Brand available for model lookup\", function () { pm.expect(brands.length).to.be.above(0); });",
          "  if (brands.length) pm.collectionVariables.set(\"brand\", encodeURIComponent(brands[0].Marca_unidad));",
          "}"
        ]
      }
    }
  ]
}
