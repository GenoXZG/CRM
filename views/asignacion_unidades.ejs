<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Asignación de Unidades | CRM TSV</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.lineicons.com/5.0/lineicons.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
    
    <div class="d-flex">
        
        <aside id="sidebar">
            <div class="sidebar-logo">
                <a href="/">
                    <div class="rounded-circle bg-primary bg-opacity-10 p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="lni lni-consulting text-primary"></i>
                    </div>
                    <span class="ms-2">CRM TSV</span>
                </a>
            </div>

            <ul class="sidebar-nav">
                <li class="sidebar-item"><a href="/" class="sidebar-link"><i class="lni lni-grid-alt"></i><span>Dashboard</span></a></li>
                <li class="sidebar-header">Gestión de Servicios</li>
                <li class="sidebar-item"><a href="/tickets" class="sidebar-link"><i class="lni lni-ticket-alt"></i><span>Crear Ticket</span></a></li>
                <li class="sidebar-item"><a href="/estado_tickets" class="sidebar-link"><i class="lni lni-stats-up"></i><span>Estado de Tickets</span></a></li>
                <li class="sidebar-item"><a href="/clientes" class="sidebar-link"><i class="lni lni-users"></i><span>Clientes</span></a></li>
                
                <li class="sidebar-header">Operativo</li>
                <li class="sidebar-item"><a href="/asignacion_unidades" class="sidebar-link active"><i class="lni lni-delivery"></i><span>Asignar Unidades</span></a></li>
                <li class="sidebar-item"><a href="/asignacion_equipos" class="sidebar-link"><i class="lni lni-network"></i><span>Asignar Equipos</span></a></li>
                <li class="sidebar-item"><a href="/registro_equipos" class="sidebar-link"><i class="lni lni-pencil-alt"></i><span>Registro Equipos</span></a></li>
                
                <li class="sidebar-header">Recursos</li>
                <li class="sidebar-item"><a href="/tecnicos" class="sidebar-link"><i class="lni lni-helmet"></i><span>Técnicos</span></a></li>
                <li class="sidebar-item"><a href="/equipos" class="sidebar-link"><i class="lni lni-display-alt"></i><span>Catálogo Equipos</span></a></li>
                <li class="sidebar-item"><a href="/unidades" class="sidebar-link"><i class="lni lni-car"></i><span>Unidades</span></a></li>
                <li class="sidebar-item"><a href="/accesorios" class="sidebar-link"><i class="lni lni-plug"></i><span>Accesorios</span></a></li>
            </ul>

            <div class="sidebar-footer">
                <a href="/logout" class="sidebar-link text-danger"><i class="lni lni-exit"></i><span>Salir</span></a>
            </div>
        </aside>

        <div class="main d-flex flex-column min-vh-100 w-100">
            
            <nav class="navbar navbar-expand border-bottom px-3 bg-white">
                <button class="toggler-btn btn" type="button"><i class="bi bi-list fs-4"></i></button>
                <span class="ms-3 fw-bold text-secondary">Operativo / Asignación</span>
            </nav>

            <main class="p-4">
                <div class="container-fluid">
                    
                    <div class="mb-4">
                        <h1 class="mb-1">Asignación de Unidades</h1>
                        <p class="text-muted">Seleccione un ticket pendiente para vincular las unidades vehiculares correspondientes.</p>
                    </div>

                    <div class="soft-card mb-4">
                        <div class="d-flex align-items-center mb-4">
                            <div class="rounded-circle bg-warning bg-opacity-10 p-2 me-3 text-warning">
                                <i class="bi bi-ticket-perforated fs-4"></i>
                            </div>
                            <h5 class="mb-0">Tickets Pendientes de Asignación</h5>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="bg-light text-muted small text-uppercase">
                                    <tr>
                                        <th class="ps-3 border-0 rounded-start">ID</th>
                                        <th class="border-0">Cliente</th>
                                        <th class="border-0">Técnico</th>
                                        <th class="border-0">Servicio</th>
                                        <th class="border-0">Unidades</th>
                                        <th class="border-0">Fecha</th>
                                        <th class="pe-3 border-0 rounded-end text-end">Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if(ticketsEspera.length > 0) { %>
                                        <% ticketsEspera.forEach(ticket => { %>
                                            <tr id="ticket-<%= ticket.ID_ticket %>">
                                                <td class="ps-3 fw-bold text-dark">#<%= ticket.ID_ticket %></td>
                                                <td><i class="bi bi-building me-2 text-muted"></i><%= ticket.Cliente.Nombre_empresa %></td>
                                                <td>
                                                    <% if(ticket.Tecnico && ticket.Tecnico.Nombre_tecnico) { %>
                                                        <span class="badge bg-light text-dark border fw-normal"><%= ticket.Tecnico.Nombre_tecnico %></span>
                                                    <% } else { %>
                                                        <span class="badge bg-warning text-dark bg-opacity-25 fw-normal">Por asignar</span>
                                                    <% } %>
                                                </td>
                                                <td><%= ticket.Tipo_servicio %></td>
                                                <td class="text-center fw-bold text-primary"><%= ticket.Numero_unidades %></td>
                                                <td class="text-muted small">
                                                    <%= ticket.Fecha_servicio ? new Date(ticket.Fecha_servicio).toLocaleString('es-MX', { day: '2-digit', month: '2-digit', hour: '2-digit', minute:'2-digit' }) : '---' %>
                                                </td>
                                                <td class="text-end pe-3">
                                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3 btn_seleccion_ticket" 
                                                            type="button"
                                                            data-id_ticket="<%= ticket.ID_ticket %>"
                                                            data-cliente="<%= ticket.Cliente.Nombre_empresa %>"
                                                            data-num_unidades="<%= ticket.Numero_unidades %>">
                                                        Seleccionar <i class="bi bi-arrow-down-circle ms-1"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr><td colspan="7" class="text-center py-5 text-muted">No hay tickets pendientes de asignación.</td></tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div id="card-asignacion" class="soft-card d-none border-start border-4 border-primary">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle bg-primary bg-opacity-10 p-2 me-3 text-primary">
                                    <i class="bi bi-car-front-fill fs-4"></i>
                                </div>
                                <div>
                                    <h5 class="mb-0">Registrar Unidades</h5>
                                    <small class="text-muted">Asignando para: <span id="lbl-cliente-seleccionado" class="fw-bold text-dark">---</span> (Ticket #<span id="lbl-ticket-seleccionado"></span>)</small>
                                </div>
                            </div>
                            <button type="button" class="btn-close" onclick="cancelarAsignacion()" aria-label="Cerrar"></button>
                        </div>

                        <form action="/add_unidades" method="POST" id="form_unidades">
                            <div class="table-responsive mb-4">
                                <table class="table align-middle">
                                    <thead class="bg-light small text-uppercase">
                                        <tr>
                                            <th style="min-width: 200px;">Marca</th>
                                            <th style="min-width: 200px;">Modelo</th>
                                            <th>Placa</th>
                                            <th>VIN / Serie</th>
                                        </tr>
                                    </thead>
                                    <tbody id="cuerpo_tabla_unidades">
                                        </tbody>
                                </table>
                            </div>
                            
                            <div class="d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-light rounded-pill px-4" onclick="cancelarAsignacion()">Cancelar</button>
                                <button type="submit" class="btn btn-primary rounded-pill px-5 shadow-sm" 
                                        id="btn_registrar_unidad" disabled
                                        style="background: linear-gradient(90deg, #4318ff 0%, #6a40ff 100%); border:none;">
                                    <i class="bi bi-save2 me-2"></i> Guardar Asignación
                                </button>
                            </div>
                        </form>
                    </div>

                </div>
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script> <script src="/scripts/sidebar.js"></script>
    <script src="/scripts/asignacion_unidades.js"></script>
</body>
</html>