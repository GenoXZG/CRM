<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Técnicos | CRM TSV</title>
    
    <link href="/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.lineicons.com/5.0/lineicons.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
    
    <div class="d-flex">
        
        <aside id="sidebar">
            <div class="sidebar-logo">
                <a href="<%= currentUser && currentUser.rol === 'admin' ? '/' : '/tickets' %>">
                    <div class="rounded-circle bg-primary bg-opacity-10 p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="lni lni-consulting text-primary"></i>
                    </div>
                    <span class="ms-2">CRM TSV</span>
                </a>
            </div>

            <ul class="sidebar-nav">
                <% if (currentUser && currentUser.rol === "admin") { %><% if (currentUser && currentUser.rol === "admin") { %><li class="sidebar-item"><a href="/" class="sidebar-link"><i class="lni lni-grid-alt"></i><span>Dashboard</span></a></li><% } %><% } %>
                <li class="sidebar-header">Gestión de Servicios</li>
                <li class="sidebar-item"><a href="/tickets" class="sidebar-link"><i class="lni lni-ticket-alt"></i><span>Tickets</span></a></li>
                <li class="sidebar-item"><a href="/clientes" class="sidebar-link"><i class="lni lni-users"></i><span>Clientes</span></a></li>
                
                <li class="sidebar-header">Operativo</li>
                <li class="sidebar-item"><a href="/asignaciones" class="sidebar-link"><i class="lni lni-delivery"></i><span>Asignaciones</span></a></li>
                <li class="sidebar-item"><a href="/registro_equipos" class="sidebar-link"><i class="lni lni-pencil-alt"></i><span>Registro Equipos</span></a></li>
                
                <li class="sidebar-header">Recursos</li>
                <li class="sidebar-item"><a href="/tecnicos" class="sidebar-link active"><i class="lni lni-helmet"></i><span>Técnicos</span></a></li>
                <li class="sidebar-item"><a href="/catalogos" class="sidebar-link"><i class="lni lni-display-alt"></i><span>Catálogos</span></a></li>
            </ul>

            <% if (currentUser && currentUser.rol === "admin") { %><div class="px-3"><a href="/usuarios" class="sidebar-link"><i class="bi bi-person-gear"></i><span>Administrar usuarios</span></a></div><% } %>
            <div class="sidebar-footer">
                <form action="/logout" method="post" style="margin:0"><button type="submit" class="sidebar-link text-danger" style="background:none;border:0;width:100%;text-align:left;cursor:pointer"><i class="lni lni-exit"></i><span>Salir</span></button></form>
            </div>
        </aside>

        <div class="main d-flex flex-column min-vh-100 w-100">
            
            <nav class="navbar navbar-expand border-bottom px-3 bg-white">
                <button class="toggler-btn btn" type="button"><i class="bi bi-list fs-4"></i></button>
                <span class="ms-3 fw-bold text-secondary">Recursos Humanos / Técnicos</span>
            </nav>

            <main class="p-4">
                <div class="container-fluid">
                    
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h1 class="mb-1">Gestión de Técnicos</h1>
                            <p class="text-muted">Administra el personal de campo y sus estados.</p>
                        </div>
                    </div>

                    <div class="soft-card mb-4">
                        <div class="d-flex align-items-center mb-4">
                            <div class="rounded-circle bg-success bg-opacity-10 p-2 me-3 text-success">
                                <i class="bi bi-person-plus-fill fs-5"></i>
                            </div>
                            <h5 class="mb-0">Registrar Nuevo Técnico</h5>
                        </div>

                        <form action="/add_tecnico" method="POST">
                            <% if (setupWizard === 'technicians') { %>
                                <input type="hidden" name="setupWizard" value="technicians">
                            <% } %>
                            <div class="row g-3 align-items-end">
                                <div class="col-md-5">
                                    <label class="form-label text-muted small fw-bold">Nombre Completo</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-0"><i class="bi bi-person"></i></span>
                                        <input type="text" class="form-control bg-light border-0" id="Nombre_tecnico" name="Nombre_tecnico" required placeholder="Ej. Roberto Gómez">
                                    </div>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label text-muted small fw-bold">Teléfono</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-0"><i class="bi bi-telephone"></i></span>
                                        <input type="tel" class="form-control bg-light border-0" id="Numero_tecnico" name="Numero_tecnico" pattern="[0-9]{10}" minlength="10" maxlength="10" inputmode="numeric" title="Ingresa exactamente 10 dígitos numéricos" required placeholder="10 dígitos" aria-describedby="ayuda-telefono-nuevo">
                                    </div>
                                  
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label text-muted small fw-bold">Estatus Inicial</label>
                                    <select class="form-select bg-light border-0" id="Estatus_tecnico" name="Estatus_tecnico" required>
                                        <option value="Activo" selected>Activo</option>
                                        <option value="Inactivo">Inactivo</option>
                                    </select>
                                </div>

                                <div class="col-md-2">
                                    <button type="submit" class="btn btn-primary w-100 rounded-pill shadow-sm" 
                                            style="background: linear-gradient(90deg, #10b981 0%, #059669 100%); border:none;">
                                        <i class="bi bi-check-lg me-1"></i> Agregar
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="soft-card">
                        <h5 class="mb-4">Plantilla de Personal</h5>
                        
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="bg-light text-muted small text-uppercase">
                                    <tr>
                                        <th class="ps-3 border-0 rounded-start">ID</th>
                                        <th class="border-0">Nombre del Técnico</th>
                                        <th class="border-0">Contacto</th>
                                        <th class="border-0">Estatus</th>
                                        <th class="pe-3 border-0 rounded-end text-end">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if(tecnicos && tecnicos.length > 0) { %>
                                        <% tecnicos.forEach(tecnico => { %>
                                            <tr>
                                                <td class="ps-3 fw-bold text-muted">#<%= tecnico.ID_Tecnico %></td>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center me-3 text-primary fw-bold border" 
                                                             style="width: 40px; height: 40px;">
                                                            <%= tecnico.Nombre_tecnico.charAt(0).toUpperCase() %>
                                                        </div>
                                                        <span class="fw-medium"><%= tecnico.Nombre_tecnico %></span>
                                                    </div>
                                                </td>
                                                <td><%= tecnico.Numero_tecnico %></td>
                                                <td>
                                                    <% if(tecnico.Estatus_tecnico === 'Activo') { %>
                                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">
                                                            <i class="bi bi-circle-fill" style="font-size: 6px; vertical-align: middle; margin-right: 4px;"></i> Activo
                                                        </span>
                                                    <% } else { %>
                                                        <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3">
                                                            <i class="bi bi-circle-fill" style="font-size: 6px; vertical-align: middle; margin-right: 4px;"></i> Inactivo
                                                        </span>
                                                    <% } %>
                                                </td>
                                                <td class="text-end pe-3">
                                                    <div class="d-flex justify-content-end gap-2">
                                                        <button class="btn btn-sm btn-outline-primary btn-icon rounded-pill px-3 btn-editar"
                                                                data-id="<%= tecnico.ID_Tecnico %>"
                                                                data-nombre="<%= tecnico.Nombre_tecnico %>"
                                                                data-estatus="<%= tecnico.Estatus_tecnico %>"
                                                                data-numero="<%= tecnico.Numero_tecnico %>"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#modalEditar">
                                                            <i class="bi bi-pencil-square"></i>
                                                        </button>
                                                        
                                                        <button class="btn btn-sm btn-outline-danger btn-icon rounded-pill px-3 btn-eliminar"
                                                                data-id="<%= tecnico.ID_Tecnico %>"
                                                                data-nombre="<%= tecnico.Nombre_tecnico %>"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#modalEliminar">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr><td colspan="5" class="text-center py-5 text-muted">No hay técnicos registrados.</td></tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </main>
        </div>
    </div>

    <div class="modal fade" id="modalEditar" data-field-map='{"modal-id":"id","modal-nombre":"nombre","modal-numero":"numero","modal-estatus":"estatus"}' tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-lg">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold ms-2">Editar Técnico</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="/editar_tecnico" method="POST">
                    <div class="modal-body pt-4">
                        <input type="hidden" name="ID_Tecnico" id="modal-id">
                        
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">Nombre Completo</label>
                            <input type="text" class="form-control bg-light border-0" name="Nombre_tecnico" id="modal-nombre" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">Teléfono</label>
                            <input type="tel" class="form-control bg-light border-0" name="Numero_tecnico" id="modal-numero" pattern="[0-9]{10}" minlength="10" maxlength="10" inputmode="numeric" title="Ingresa exactamente 10 dígitos numéricos" aria-describedby="ayuda-telefono-editar" required>
                            <div id="ayuda-telefono-editar" class="form-text">Debe contener exactamente 10 dígitos, sin espacios ni guiones.</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">Estatus</label>
                            <select class="form-select bg-light border-0" name="Estatus_tecnico" id="modal-estatus" required>
                                <option value="Activo">Activo</option>
                                <option value="Inactivo">Inactivo</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4" style="background-color: var(--pastel-green-text); border:none;">Guardar Cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalEliminar" data-field-map='{"modal_eliminar-id":"id","modal_eliminar-nombre":"nombre"}' tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-lg">
                <div class="modal-body text-center p-5">
                    <div class="mb-4 text-danger bg-danger bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="bi bi-exclamation-triangle fs-1"></i>
                    </div>
                    <h4 class="mb-2">¿Confirmar Eliminación?</h4>
                    <p class="text-muted mb-4">Vas a eliminar al técnico <span id="modal_eliminar-nombre" class="fw-bold text-dark"></span>. Esta acción es irreversible.</p>
                    
                    <form action="/eliminar_tecnico" method="POST" class="d-flex justify-content-center gap-3">
                        <input type="hidden" name="ID_Tecnico" id="modal_eliminar-id">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-danger rounded-pill px-4">Sí, Eliminar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
    
    <script type="module" src="/assets/pages/common.js"></script>
</body>
</html>