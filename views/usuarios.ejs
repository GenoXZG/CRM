<!DOCTYPE html>
<html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Administrar usuarios | CRM TSV</title>
<link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css"><link rel="stylesheet" href="https://cdn.lineicons.com/5.0/lineicons.css"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css"><link rel="stylesheet" href="/css/styles.css"><link rel="stylesheet" href="/css/dashboard.css"><link rel="stylesheet" href="/css/usuarios.css"></head>
<body><div class="d-flex">
<aside id="sidebar"><div class="sidebar-logo"><a href="/"><div class="rounded-circle bg-primary bg-opacity-10 p-2 d-flex align-items-center justify-content-center" style="width:40px;height:40px"><i class="lni lni-consulting text-primary"></i></div><span class="ms-2">CRM TSV</span></a></div>
<ul class="sidebar-nav"><li class="sidebar-item"><a href="/" class="sidebar-link"><i class="lni lni-grid-alt"></i><span>Dashboard</span></a></li><li class="sidebar-item"><a href="/usuarios" class="sidebar-link active" aria-current="page"><i class="bi bi-person-gear"></i><span>Administrar usuarios</span></a></li><li class="sidebar-header">Gestión de Servicios</li><li class="sidebar-item"><a href="/tickets" class="sidebar-link"><i class="lni lni-ticket-alt"></i><span>Tickets</span></a></li><li class="sidebar-item"><a href="/clientes" class="sidebar-link"><i class="lni lni-users"></i><span>Clientes</span></a></li><li class="sidebar-header">Operativo</li><li class="sidebar-item"><a href="/asignaciones" class="sidebar-link"><i class="lni lni-delivery"></i><span>Asignaciones</span></a></li><li class="sidebar-item"><a href="/registro_equipos" class="sidebar-link"><i class="lni lni-pencil-alt"></i><span>Registro Equipos</span></a></li><li class="sidebar-header">Recursos</li><li class="sidebar-item"><a href="/tecnicos" class="sidebar-link"><i class="lni lni-helmet"></i><span>Técnicos</span></a></li><li class="sidebar-item"><a href="/catalogos" class="sidebar-link"><i class="lni lni-display-alt"></i><span>Catálogos</span></a></li></ul>
<div class="sidebar-footer"><form action="/logout" method="post" class="m-0"><button class="sidebar-link text-danger" style="background:none;border:0;width:100%;text-align:left" type="submit"><i class="lni lni-exit"></i><span>Cerrar sesión</span></button></form></div></aside>
<div class="main d-flex flex-column min-vh-100 w-100"><nav class="navbar navbar-expand border-bottom px-3 bg-white"><button class="toggler-btn btn" type="button" aria-label="Abrir o cerrar menú"><i class="bi bi-list fs-4"></i></button><span class="ms-auto text-muted small me-3"><i class="bi bi-person-circle me-1"></i><%= currentUser.correo %></span><form action="/logout" method="post" class="mb-0"><button class="btn btn-outline-danger btn-sm" type="submit"><i class="bi bi-box-arrow-right"></i> Cerrar sesión</button></form></nav>
<main class="p-4 flex-grow-1"><div class="container-fluid"><div class="mb-4"><p class="text-muted mb-1">Administración · Acceso exclusivo para administradores</p><h1 class="mb-2">Administrar usuarios</h1><p class="text-muted">Crea, edita y gestiona las cuentas que pueden ingresar al CRM.</p></div>
<% if(error) { %><div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-triangle me-2"></i><%= error %></div><% } %><% if(success) { %><div class="alert alert-success" role="status"><i class="bi bi-check-circle me-2"></i><%= success %></div><% } %>
<section class="soft-card mb-4 user-card"><div class="d-flex align-items-center gap-3 mb-3"><div class="user-icon"><i class="bi bi-person-plus"></i></div><div><h2 class="h5 mb-1">Agregar nuevo usuario</h2><p class="text-muted small mb-0">Las contraseñas deben tener al menos 12 caracteres.</p></div></div>
<form action="/usuarios/crear" method="post" class="row g-3 user-form" data-confirm-password><div class="col-lg-5"><label for="correo" class="form-label">Correo electrónico</label><input id="correo" name="correo" class="form-control" type="email" required maxlength="254" placeholder="tecnico@gmail.com" autocomplete="off"></div><div class="col-lg-3"><label for="rol" class="form-label">Rol</label><select class="form-select" id="rol" name="rol"><option value="tecnico">Técnico</option><option value="coordinador">Coordinador</option></select></div><div class="col-lg-4"></div>
<div class="col-lg-6"><label for="password" class="form-label">Contraseña</label><div class="input-group"><input class="form-control" id="password" name="password" type="password" minlength="12" maxlength="1024" required autocomplete="new-password"><button class="btn btn-outline-secondary toggle-password" type="button" data-target="password" aria-label="Mostrar contraseña" aria-pressed="false" title="Mostrar contraseña"><i class="bi bi-eye"></i></button></div></div>
<div class="col-lg-6"><label for="confirmPassword" class="form-label">Confirmar contraseña</label><div class="input-group"><input class="form-control" id="confirmPassword" name="confirmPassword" type="password" minlength="12" maxlength="1024" required autocomplete="new-password"><button class="btn btn-outline-secondary toggle-password" type="button" data-target="confirmPassword" aria-label="Mostrar contraseña" aria-pressed="false" title="Mostrar contraseña"><i class="bi bi-eye"></i></button></div><div class="invalid-feedback d-block password-feedback" aria-live="polite"></div></div>
<div class="col-12 d-flex justify-content-end"><button type="submit" class="btn btn-primary px-4"><i class="bi bi-person-plus me-1"></i> Crear usuario</button></div></form></section>
<section class="soft-card user-card"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h2 class="h5 mb-1">Usuarios registrados</h2><p class="text-muted small mb-0"><span id="userCount"><%= users.length %></span> usuarios encontrados</p></div><button type="button" class="btn btn-outline-secondary btn-sm" id="clearFilters"><i class="bi bi-arrow-counterclockwise"></i> Limpiar filtros</button></div>
<div class="row g-3 mb-4"><div class="col-lg-5"><label class="form-label" for="filterEmail">Buscar por correo</label><div class="input-group"><span class="input-group-text"><i class="bi bi-search"></i></span><input id="filterEmail" class="form-control" type="search" placeholder="Escribe un correo..."></div></div><div class="col-lg-3"><label class="form-label" for="filterRole">Filtrar por rol</label><select id="filterRole" class="form-select"><option value="">Todos los roles</option><option value="admin">Administrador</option><option value="coordinador">Coordinador</option><option value="tecnico">Técnico</option></select></div><div class="col-lg-4"><label class="form-label" for="filterDate">Fecha de registro</label><select id="filterDate" class="form-select"><option value="">Cualquier fecha</option><option value="7">Última semana</option><option value="month">Último mes</option><option value="sixmonths">Últimos 6 meses</option><option value="year">Último año</option></select></div></div>
<div class="table-responsive"><table class="table table-hover align-middle users-table"><thead><tr><th>Correo</th><th>Rol</th><th>Fecha de registro</th><th>Acciones</th></tr></thead><tbody>
<% users.forEach(function(user) { %><tr class="user-row" data-email="<%= user.correo %>" data-role="<%= user.rol %>" data-date="<%= new Date(user.creado_en).toISOString() %>"><td class="fw-semibold"><i class="bi bi-person-circle text-primary me-2"></i><%= user.correo %></td><td><span class="badge <%= user.rol === 'admin' ? 'text-bg-primary' : user.rol === 'coordinador' ? 'text-bg-info' : 'text-bg-secondary' %>"><%= user.rol === 'admin' ? 'Administrador' : user.rol === 'coordinador' ? 'Coordinador' : 'Técnico' %></span></td><td><%= new Date(user.creado_en).toLocaleDateString('es-MX') %></td><td>
<% if(user.rol !== 'admin') { %><div class="d-flex flex-wrap gap-2"><button type="button" class="btn btn-sm btn-outline-primary edit-toggle" data-bs-toggle="collapse" data-bs-target="#edit-<%= user.id %>" aria-expanded="false" aria-controls="edit-<%= user.id %>"><i class="bi bi-pencil-square"></i> Editar</button><form action="/usuarios/<%= user.id %>/eliminar" method="post" onsubmit="return confirm('¿Eliminar esta cuenta? También se cerrarán sus sesiones.');"><button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Eliminar</button></form></div><% } else { %><span class="text-muted small"><i class="bi bi-shield-lock"></i> Cuenta protegida</span><% } %></td></tr>
<% if(user.rol !== 'admin') { %><tr class="edit-row user-edit-row" data-owner="<%= user.id %>"><td colspan="4" class="p-0"><div class="collapse" id="edit-<%= user.id %>"><div class="edit-panel m-3 p-3"><h3 class="h6 mb-3"><i class="bi bi-pencil-square me-2"></i>Editar cuenta: <%= user.correo %></h3><form class="row g-3 user-form" action="/usuarios/<%= user.id %>/editar" method="post"><div class="col-md-6"><label for="edit-email-<%= user.id %>" class="form-label">Correo</label><input id="edit-email-<%= user.id %>" class="form-control" type="email" name="correo" value="<%= user.correo %>" maxlength="254" required></div><div class="col-md-6"><label for="edit-role-<%= user.id %>" class="form-label">Rol</label><select id="edit-role-<%= user.id %>" class="form-select" name="rol"><option value="tecnico" <%= user.rol === 'tecnico' ? 'selected' : '' %>>Técnico</option><option value="coordinador" <%= user.rol === 'coordinador' ? 'selected' : '' %>>Coordinador</option></select></div><div class="col-md-6"><label class="form-label" for="edit-password-<%= user.id %>">Nueva contraseña (opcional)</label><div class="input-group"><input id="edit-password-<%= user.id %>" name="password" class="form-control" type="password" minlength="12" maxlength="1024" autocomplete="new-password" placeholder="Dejar vacío para conservar"><button type="button" class="btn btn-outline-secondary toggle-password" data-target="edit-password-<%= user.id %>" aria-label="Mostrar contraseña" aria-pressed="false"><i class="bi bi-eye"></i></button></div></div><div class="col-md-6"><label for="edit-confirm-<%= user.id %>" class="form-label">Confirmar nueva contraseña</label><div class="input-group"><input id="edit-confirm-<%= user.id %>" name="confirmPassword" class="form-control" type="password" minlength="12" maxlength="1024" autocomplete="new-password" placeholder="Repetir si cambias contraseña"><button type="button" class="btn btn-outline-secondary toggle-password" data-target="edit-confirm-<%= user.id %>" aria-label="Mostrar contraseña" aria-pressed="false"><i class="bi bi-eye"></i></button></div><div class="invalid-feedback d-block password-feedback" aria-live="polite"></div></div><div class="col-12"><button class="btn btn-primary" type="submit"><i class="bi bi-check-lg"></i> Guardar cambios</button></div></form></div></div></td></tr><% } %>
<% }); %></tbody></table><p id="noUsers" class="text-center text-muted py-4 d-none">No se encontraron usuarios con esos filtros.</p></div></section></div></main><footer class="mt-auto py-3 text-center text-muted small">© 2025 CRM TSV - Desarrollado por GenoxZG</footer></div></div>
<script src="/bootstrap/js/bootstrap.bundle.min.js"></script><script src="/js/usuarios.js" defer></script></body></html>