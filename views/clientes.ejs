<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Clientes | CRM TSV</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.lineicons.com/5.0/lineicons.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
    
    <div class="d-flex">
        
        <aside id="sidebar">
            <div class="sidebar-logo">
                <a href="/">
                    <div class="rounded-circle bg-primary bg-opacity-10 p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="lni lni-consulting text-primary"></i>
                    </div>
                    <span class="ms-2">CRM TSV</span>
                </a>
            </div>

            <ul class="sidebar-nav">
                <li class="sidebar-item"><a href="/" class="sidebar-link"><i class="lni lni-grid-alt"></i><span>Dashboard</span></a></li>
                <li class="sidebar-header">Gestión de Servicios</li>
                <li class="sidebar-item"><a href="/tickets" class="sidebar-link"><i class="lni lni-ticket-alt"></i><span>Crear Ticket</span></a></li>
                <li class="sidebar-item"><a href="/estado_tickets" class="sidebar-link"><i class="lni lni-stats-up"></i><span>Estado de Tickets</span></a></li>
                <li class="sidebar-item"><a href="/clientes" class="sidebar-link active"><i class="lni lni-users"></i><span>Clientes</span></a></li>
                
                <li class="sidebar-header">Operativo</li>
                <li class="sidebar-item"><a href="/asignacion_unidades" class="sidebar-link"><i class="lni lni-delivery"></i><span>Asignar Unidades</span></a></li>
                <li class="sidebar-item"><a href="/asignacion_equipos" class="sidebar-link"><i class="lni lni-network"></i><span>Asignar Equipos</span></a></li>
                <li class="sidebar-item"><a href="/registro_equipos" class="sidebar-link"><i class="lni lni-pencil-alt"></i><span>Registro Equipos</span></a></li>
                
                <li class="sidebar-header">Recursos</li>
                <li class="sidebar-item"><a href="/tecnicos" class="sidebar-link"><i class="lni lni-helmet"></i><span>Técnicos</span></a></li>
                <li class="sidebar-item"><a href="/equipos" class="sidebar-link"><i class="lni lni-display-alt"></i><span>Catálogo Equipos</span></a></li>
                <li class="sidebar-item"><a href="/unidades" class="sidebar-link"><i class="lni lni-car"></i><span>Unidades</span></a></li>
                <li class="sidebar-item"><a href="/accesorios" class="sidebar-link"><i class="lni lni-plug"></i><span>Accesorios</span></a></li>
            </ul>

            <div class="sidebar-footer">
                <a href="/logout" class="sidebar-link text-danger"><i class="lni lni-exit"></i><span>Salir</span></a>
            </div>
        </aside>

        <div class="main d-flex flex-column min-vh-100 w-100">
            
            <nav class="navbar navbar-expand border-bottom px-3 bg-white">
                <button class="toggler-btn btn" type="button"><i class="bi bi-list fs-4"></i></button>
                <span class="ms-3 fw-bold text-secondary">Directorio de Clientes</span>
            </nav>

            <main class="p-4">
                <div class="container-fluid">
                    
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h1 class="mb-1">Gestión de Clientes</h1>
                            <p class="text-muted">Administra la información de contacto de las empresas.</p>
                        </div>
                    </div>

                    <div class="soft-card mb-4">
                        <div class="d-flex align-items-center mb-4">
                            <div class="rounded-circle bg-primary bg-opacity-10 p-2 me-3 text-primary">
                                <i class="bi bi-person-plus-fill fs-5"></i>
                            </div>
                            <h5 class="mb-0">Registrar Nuevo Cliente</h5>
                        </div>

                        <form action="/add_cliente" method="POST">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label text-muted small fw-bold">Nombre de la Empresa</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-0"><i class="bi bi-building"></i></span>
                                        <input type="text" class="form-control bg-light border-0" id="Nombre_empresa" name="Nombre_empresa" required placeholder="Ej. Tech Solutions S.A.">
                                    </div>
                                </div>
                                
                                <div class="col-md-4">
                                    <label class="form-label text-muted small fw-bold">Nombre del Encargado</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-0"><i class="bi bi-person"></i></span>
                                        <input type="text" class="form-control bg-light border-0" id="Encargado" name="Encargado" required placeholder="Ej. Juan Pérez">
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label text-muted small fw-bold">Teléfono de Contacto</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-0"><i class="bi bi-telephone"></i></span>
                                        <input type="tel" class="form-control bg-light border-0" id="Numero" name="Numero" required placeholder="Ej. 55 1234 5678">
                                    </div>
                                </div>
                            </div>
                            
                            <div class="d-flex justify-content-end mt-4">
                                <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm" style="background-color: var(--pastel-purple-text); border:none;">
                                    <i class="bi bi-save2 me-2"></i> Guardar Cliente
                                </button>
                            </div>
                        </form>
                    </div>

                    <div class="soft-card">
                        <h5 class="mb-4">Directorio Registrado</h5>
                        
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="bg-light text-muted small text-uppercase">
                                    <tr>
                                        <th class="ps-3 border-0 rounded-start">ID</th>
                                        <th class="border-0">Empresa</th>
                                        <th class="border-0">Encargado</th>
                                        <th class="border-0">Teléfono</th>
                                        <th class="pe-3 border-0 rounded-end text-end">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if(clientes && clientes.length > 0) { %>
                                        <% clientes.forEach(cliente => { %>
                                            <tr>
                                                <td class="ps-3 fw-bold text-muted">#<%= cliente.ID_cliente %></td>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center me-3 text-primary fw-bold" style="width: 40px; height: 40px;">
                                                            <%= cliente.Nombre_empresa.charAt(0).toUpperCase() %>
                                                        </div>
                                                        <span class="fw-medium"><%= cliente.Nombre_empresa %></span>
                                                    </div>
                                                </td>
                                                <td class="text-muted"><%= cliente.Encargado %></td>
                                                <td>
                                                    <span class="badge bg-light text-dark border fw-normal">
                                                        <i class="bi bi-telephone me-1"></i> <%= cliente.Numero %>
                                                    </span>
                                                </td>
                                                <td class="text-end pe-3">
                                                    <div class="d-flex justify-content-end gap-2">
                                                        <button class="btn btn-sm btn-outline-primary btn-icon rounded-pill px-3 btn-editar"
                                                                data-id="<%= cliente.ID_cliente %>"
                                                                data-nombre="<%= cliente.Nombre_empresa %>"
                                                                data-encargado="<%= cliente.Encargado %>"
                                                                data-numero="<%= cliente.Numero %>"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#modalEditar">
                                                            <i class="bi bi-pencil-square"></i>
                                                        </button>
                                                        
                                                        <button class="btn btn-sm btn-outline-danger btn-icon rounded-pill px-3 btn-eliminar"
                                                                data-id="<%= cliente.ID_cliente %>"
                                                                data-nombre="<%= cliente.Nombre_empresa %>"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#modalEliminar">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="5" class="text-center py-5 text-muted">
                                                <i class="bi bi-folder-x fs-1 d-block mb-2"></i>
                                                No hay clientes registrados aún.
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </main>
        </div>
    </div>

    <div class="modal fade" id="modalEditar" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-lg">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold ms-2">Editar Información</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="/editar_cliente" method="POST">
                    <div class="modal-body pt-4">
                        <input type="hidden" name="ID_cliente" id="modal-id">
                        
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">Nombre de la Empresa</label>
                            <input type="text" class="form-control bg-light border-0" name="Nombre_empresa" id="modal-nombre_empresa" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">Nombre del Encargado</label>
                            <input type="text" class="form-control bg-light border-0" name="Encargado" id="modal-nombre_encargado" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">Teléfono</label>
                            <input type="text" class="form-control bg-light border-0" name="Numero" id="modal-numero" required>
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4" style="background-color: var(--pastel-purple-text); border:none;">Guardar Cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalEliminar" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-lg">
                <div class="modal-body text-center p-5">
                    <div class="mb-4 text-danger bg-danger bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="bi bi-exclamation-triangle fs-1"></i>
                    </div>
                    <h4 class="mb-2">¿Estás seguro?</h4>
                    <p class="text-muted mb-4">Vas a eliminar al cliente <span id="delete-nombre-cliente" class="fw-bold text-dark"></span>. Esta acción no se puede deshacer.</p>
                    
                    <form action="/eliminar_cliente" method="POST" class="d-flex justify-content-center gap-3">
                        <input type="hidden" name="ID_cliente" id="delete-id-cliente">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-danger rounded-pill px-4">Sí, Eliminar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Toggle Sidebar
        const toggler = document.querySelector(".toggler-btn");
        if(toggler) toggler.addEventListener("click", () => document.querySelector("#sidebar").classList.toggle("collapsed"));

        // Lógica para llenar el Modal Editar
        const modalEditar = document.getElementById('modalEditar');
        if (modalEditar) {
            modalEditar.addEventListener('show.bs.modal', event => {
                const button = event.relatedTarget;
                
                // Extraer datos
                const id = button.getAttribute('data-id');
                const nombre = button.getAttribute('data-nombre');
                const encargado = button.getAttribute('data-encargado');
                const numero = button.getAttribute('data-numero');

                // Llenar inputs
                modalEditar.querySelector('#modal-id').value = id;
                modalEditar.querySelector('#modal-nombre_empresa').value = nombre;
                modalEditar.querySelector('#modal-nombre_encargado').value = encargado;
                modalEditar.querySelector('#modal-numero').value = numero;
            });
        }

        // Lógica para llenar el Modal Eliminar
        const modalEliminar = document.getElementById('modalEliminar');
        if (modalEliminar) {
            modalEliminar.addEventListener('show.bs.modal', event => {
                const button = event.relatedTarget;
                const id = button.getAttribute('data-id');
                const nombre = button.getAttribute('data-nombre');
                
                modalEliminar.querySelector('#delete-id-cliente').value = id;
                modalEliminar.querySelector('#delete-nombre-cliente').textContent = nombre;
            });
        }
    </script>
</body>
</html>